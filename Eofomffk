local success, OrionLib = pcall(function()
    return loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
end)

if not success or not OrionLib then
    warn("Failed to load Orion Library. Check your internet or executor HTTP get support.")
    return
end

local Window = OrionLib:MakeWindow({Name = "Siddhant Hub", HidePremium = false, SaveConfig = true, ConfigFolder = "SiddhantConfig"})

local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Keep character updated on respawn
Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HumanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
end)

-- // Global Control Variables \\
getgenv().FlyEnabled = false
getgenv().NoAnimEnabled = false
getgenv().FlySpeed = 50 -- Default speed

-- // Function: Fly Mechanism \\
local function ToggleFly(state)
    getgenv().FlyEnabled = state
    if getgenv().FlyEnabled then
        task.spawn(function()
            local bg = Instance.new("BodyGyro", HumanoidRootPart)
            local bv = Instance.new("BodyVelocity", HumanoidRootPart)
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e4, 9e4, 9e4)
            bv.maxForce = Vector3.new(9e4, 9e4, 9e4)
            
            while getgenv().FlyEnabled and Character and Character:FindFirstChild("HumanoidRootPart") do
                local cam = workspace.CurrentCamera
                bg.cframe = cam.CFrame
                bv.velocity = cam.CFrame.lookVector * getgenv().FlySpeed
                task.wait()
            end
            
            bg:Destroy()
            bv:Destroy()
        end)
    end
end

-- // Function: No Animation Mechanism \\
task.spawn(function()
    while true do
        task.wait(0.1)
        if getgenv().NoAnimEnabled and Player.Character then
            local humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local animTable = humanoid:GetPlayingAnimationTracks()
                for _, track in ipairs(animTable) do
                    track:Stop()
                end
            end
        end
    end
end)

